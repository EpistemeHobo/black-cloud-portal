# Copy to backend/.env for local development. Never commit .env.
# In production these come from the Kubernetes ConfigMap and Secret (see deployment.template.yaml).

# development | production
ENVIRONMENT=development

# Signs session cookies and emailed links. Required in production; at least 32 random characters.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Every system, attached files included, is scanned for leaked secrets this often (hours).
# 0 turns the scheduled scan off; `python -m app.leak_scan` runs it from a cron job instead.
SECRET_SCAN_INTERVAL_HOURS=24

# Default: SQLite at backend/instance/portal.db. PostgreSQL (Aurora) also works, either as a URL:
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname
DATABASE_URL=
# ...or in parts, when DATABASE_URL is empty (the password needs no URL escaping this way).
# DB_HOST is the Aurora cluster's writer endpoint.
DB_HOST=
DB_PORT=5432
DB_NAME=portal
DB_USER=
DB_PASSWORD=

# Markdown files attached to the handover guide go to this S3 bucket (turn on versioning).
# Empty: they stay in the database. Credentials come from the instance profile on
# EC2/Beanstalk (LabInstanceProfile in Learner Lab), or ~/.aws/credentials locally.
# After setting it on a portal that already has files: python -m app.doc_store
DOCS_BUCKET=
DOCS_PREFIX=
AWS_REGION=us-east-1

# Hostnames the app answers to (comma-separated). Empty means any, for local use.
ALLOWED_HOSTS=
# Only when the Next.js dev server runs on another port, e.g. http://localhost:3000
ALLOWED_ORIGINS=
# Secure cookies need HTTPS. Defaults to true in production, false otherwise.
COOKIE_SECURE=

# The first admin, created at start-up so someone can approve sign-ups.
# SEED_ADMIN_RESET=true re-applies the password to an existing account (a forgotten
# admin password); turn it off again afterwards. 12+ characters in production.
SEED_ADMIN_EMAIL=admin@example.org
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_RESET=
# Sign-in through a Cognito user pool, when all three are set (the domain with https://).
# The portal's own passwords and SMTP are then unused, and SEED_ADMIN_PASSWORD is ignored:
# create a Cognito user with the same email as SEED_ADMIN_EMAIL. Empty: the portal's own passwords.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
# The contact shown on the sign-in page (email and Webex). Default: the seed admin.
SUPPORT_EMAIL=
# Only these email domains may sign up (comma-separated, subdomains included). Empty: any.
ALLOWED_EMAIL_DOMAINS=

# Email, for verifying addresses and resetting passwords. Required in production.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USERNAME=resend, SMTP_PASSWORD=<API key>,
# MAIL_FROM on a domain verified in Resend. Empty: emails go to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# The portal's address, for the links in emails. Required in production.
PUBLIC_BASE_URL=http://localhost:8000

# Checklist items link to pages under this address.
KB_BASE_URL=http://127.0.0.1:8010
# Where the built frontend is, relative to backend/ (default: static_frontend).
FRONTEND_DIR=../frontend/out
SESSION_HOURS=12
